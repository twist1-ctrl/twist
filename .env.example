# Environment variables for Pulseem integration

# Pulseem API URL
PULSEEM_API_URL=https://ui-api.pulseem.com

# Pulseem API Key - Get this from your Pulseem account dashboard
PULSEEM_API_KEY=your-api-key-here

# Pulseem Group IDs - JSON array format. You can add multiple group IDs
# Example: [1, 2, 3]
PULSEEM_GROUP_IDS=[0]

# Contentful Configuration
# Get these values from your Contentful dashboard:
# Settings > API keys > Content delivery / preview tokens
NEXT_PUBLIC_CONTENTFUL_SPACE_ID=your_space_id_here
NEXT_PUBLIC_CONTENTFUL_ACCESS_TOKEN=your_access_token_here
NEXT_PUBLIC_CONTENTFUL_ENVIRONMENT_ID=master

# Google Analytics 4
# Get your Measurement ID from: Google Analytics > Admin > Data Streams > your stream > Measurement ID
# Format: G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Optional Puppeteer override for non-Vercel environments (use when Chrome is preinstalled on the server)
# Example: /usr/bin/google-chrome-stable
PUPPETEER_EXECUTABLE_PATH=

# Post Revalidation
# ISR revalidation interval in seconds for blog posts (default: 1 day = 86400 seconds)
NEXT_POST_REVALIDATE_SECONDS=86400

# AppBar Visibility
# Set to 'true' to hide the AppBar component (default is false)
NEXT_PUBLIC_HIDE_APP_BAR=false

# Public contact details used in the Contact page
NEXT_PUBLIC_CONTACT_EMAIL=twist1@twist1.co.il
NEXT_PUBLIC_CONTACT_PHONE=058-321-7458
NEXT_PUBLIC_CONTACT_WHATSAPP=053-454-1676